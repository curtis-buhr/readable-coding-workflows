<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(FixtureRevision)' &gt;= '1'">$(DefineConstants);STAGE1</DefineConstants>
    <DefineConstants Condition="'$(FixtureRevision)' &gt;= '2'">$(DefineConstants);STAGE2</DefineConstants>
    <DefineConstants Condition="'$(FixtureRevision)' &gt;= '3'">$(DefineConstants);STAGE3</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="submission/Challenge.csproj" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
